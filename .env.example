# Modèle de configuration. À copier : cp .env.example .env
# Le fichier .env n'est jamais commité (il est dans .gitignore).

# Base PostgreSQL créée par compose.yaml
POSTGRES_USER=market
POSTGRES_PASSWORD=market
POSTGRES_DB=market

# Adresse de la base utilisée par le serveur Go
DATABASE_URL=postgres://market:market@localhost:5432/market?sslmode=disable

# Adresse de la base utilisée par les tests de internal/store
TEST_DATABASE_URL=postgres://market:market@localhost:5432/market?sslmode=disable

# Administrateur créé au démarrage du serveur
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
